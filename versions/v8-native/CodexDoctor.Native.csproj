<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CodexDoctor</AssemblyName>
    <RootNamespace>CodexDoctor.Native</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>8.1.0</Version>
    <Product>Codex Doctor</Product>
    <Company>Aix</Company>
    <Authors>Aix</Authors>
    <Copyright>Copyright © Aix</Copyright>
    <Description>Codex Doctor 一键扫描、智能问题分级与安全自动维修中心</Description>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>
</Project>
